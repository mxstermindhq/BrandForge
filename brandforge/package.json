{
  "name": "brandforge",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0 <22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "node scripts/optimize-site-images.mjs && node scripts/generate-llms-txt.mjs && next build && node scripts/prune-portfolio-out.mjs && node scripts/track-bundles.mjs && node scripts/audit-images.mjs && node scripts/generate-dashboard-data.mjs",
    "pre-deploy": "node scripts/pre-deploy.mjs",
    "pre-deploy:quick": "node scripts/pre-deploy.mjs --skip-lighthouse",
    "post-deploy": "node scripts/post-deploy.mjs",
    "audit:perf": "node scripts/audit-perf-all.mjs",
    "audit:perf:fast": "node scripts/audit-perf-all.mjs --fast",
    "audit:images": "node scripts/audit-images.mjs",
    "audit:links": "node scripts/check-links.mjs",
    "audit:schema": "node scripts/validate-schema.mjs",
    "audit:bundles": "node scripts/track-bundles.mjs",
    "report:weekly": "node scripts/weekly-report.mjs",
    "dashboard:data": "node scripts/generate-dashboard-data.mjs",
    "optimize:site": "node scripts/optimize-site-images.mjs",
    "start": "next start -p 3002",
    "lint": "eslint .",
    "lint:content": "node scripts/lint-content.mjs",
    "optimize:portfolio": "node scripts/optimize-portfolio-images.mjs",
    "predeploy": "node scripts/pre-deploy-check.mjs",
    "deploy": "npm run pre-deploy:quick && node scripts/purge-cache.mjs && npx wrangler deploy --config wrangler.jsonc && node scripts/post-deploy.mjs && node scripts/notify-discord.mjs deploy \"Deployed to brandforge.gg\""
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@react-three/drei": "^10.0.6",
    "@react-three/fiber": "^9.1.2",
    "gsap": "^3.13.0",
    "lenis": "^1.3.3",
    "next": "^15.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^20.17.30",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.175.0",
    "eslint": "^9.24.0",
    "eslint-config-next": "^15.5.15",
    "postcss": "^8.5.3",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3"
  }
}
