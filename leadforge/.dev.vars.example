# Copy to .env.local for local dev (Next.js reads .env.local automatically).
# Supabase — create a project at https://supabase.com, run supabase/schema.sql in SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: apply schema via `SUPABASE_ACCESS_TOKEN=... node scripts/apply-supabase-schema.mjs`
# (personal token from https://supabase.com/dashboard/account/tokens)

# Google OAuth: enable in Supabase Dashboard → Auth → Providers → Google.
# Add redirect URLs in Supabase → Auth → URL Configuration:
#   http://localhost:3003/auth/callback
#   https://leadforge-gilt.vercel.app/auth/callback

# App
APP_URL=http://localhost:3003
APP_ENV=development
ADMIN_EMAIL=

# AI + search
GEMINI_API_KEY=
GEMINI_MODEL=
SEARCH_PROVIDER=serper
SERPER_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Third-party lead sources
APOLLO_API_KEY=
APIFY_API_KEY=
APIFY_USER_ID=
# Optional per-platform Apify actor overrides (e.g. APIFY_ACTOR_REDDIT=owner/actor)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM=
