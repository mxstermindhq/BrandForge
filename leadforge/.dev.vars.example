# Copy to .env.local for local dev (Next.js reads .env.local automatically).
# Supabase — create a project at https://supabase.com, run supabase/schema.sql in SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
APP_URL=http://localhost:3003
APP_ENV=development
ADMIN_EMAIL=

# AI + search
GEMINI_API_KEY=
GEMINI_MODEL=
SEARCH_PROVIDER=serper
SERPER_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Billing + email (optional locally)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
