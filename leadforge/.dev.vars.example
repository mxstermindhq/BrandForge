# Copy to .dev.vars (gitignored) for local development with `wrangler dev`.
GEMINI_API_KEY=
GEMINI_MODEL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=
JWT_SECRET=
ADMIN_EMAIL=

# Search provider (optional). Blank = free DuckDuckGo. Provide one to upgrade.
SEARCH_PROVIDER=
SERPER_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=

# Vercel production (Turso + Upstash). Not needed for wrangler local dev.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# APP_URL=https://your-app.vercel.app
